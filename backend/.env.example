# CloudGuard AI — Backend Environment Configuration
#
# This file is a TEMPLATE. Copy it to .env (or set these as environment
# variables on your hosting provider) and adjust the values for your deployment.
# The .env.example file itself does not configure hosting automatically —
# the hosting environment must read these variables at startup.

# ---------------------------------------------------------------------------
# PRODUCTION SAFETY — Demo-Only Mode
# ---------------------------------------------------------------------------

# Set to "false" in any deployment where live AWS credential entry must not
# be permitted (public demos, shared hosting, jury presentations, etc.).
#
# When false:
#   - GET  /api/identity          → 403 LIVE_AWS_DISABLED
#   - POST /api/identity          → 403 LIVE_AWS_DISABLED
#   - POST /api/scan (mode=live)  → 403 LIVE_AWS_DISABLED
#   - GET  /api/regions?profile=  → skips AWS DescribeRegions enrichment
#   - No Boto3 session is created for any of the above
#
# Demo-mode scanning continues to work normally.
#
# Default: true (local development — allows live AWS scanning with credentials)
# Production: MUST be set to false
ALLOW_LIVE_AWS_SCANS=false

# ---------------------------------------------------------------------------
# Core Settings
# ---------------------------------------------------------------------------

# Default scan provider when no mode is sent in the request body.
# "simulated" = demo mode (JSON fixtures). "boto3" = live mode (requires credentials).
SCANNER_PROVIDER=simulated

# Default AWS profile for live scans (only used when ALLOW_LIVE_AWS_SCANS=true).
# AWS_PROFILE=default

# Default region for EC2 scanning.
AWS_DEFAULT_REGION=eu-north-1

# CORS origins (comma-separated). Must include the frontend URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
